# Configuração da Comanda.
# Copie este arquivo para "configuracao.env" (na mesma pasta), ajuste e reinicie o sistema.
# Linhas começadas com # são ignoradas. Valores com espaços ou com "$" vão entre aspas simples.

# --- Estabelecimento ---
# O nome, o endereço e a taxa de serviço também podem ser mudados pelo sistema (menu Ajustes).
FUSO_HORARIO=America/Sao_Paulo

# --- Rede ---
# A porta 5000 já é usada pelo Painel de Propagandas no mesmo servidor.
PORTA=5001

# --- Backups ---
# Quantos backups diários manter (0 desliga o backup automático).
BACKUP_MANTER=14
