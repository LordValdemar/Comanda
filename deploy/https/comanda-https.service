# HTTPS da Comanda na rede local (Caddy). Instalado por deploy/ativar-https.sh.
[Unit]
Description=Comanda - HTTPS na rede local (Caddy)
After=network-online.target comanda.service
Wants=network-online.target

[Service]
Type=simple
User=__USUARIO__
ExecStart=__CADDY__ run --config __PASTA__/dados/https/Caddyfile --adapter caddyfile
Restart=always
RestartSec=5
# O Caddy guarda a autoridade local e os certificados em dados/https.
Environment=HOME=__PASTA__/dados/https
Environment=XDG_DATA_HOME=__PASTA__/dados/https
Environment=XDG_CONFIG_HOME=__PASTA__/dados/https
# Chave da Cloudflare (só com domínio próprio). O systemd lê o arquivo antes de trocar de usuário.
EnvironmentFile=-/etc/comanda/cloudflare.env
# Permite usar a porta 443 (endereço sem número) sem rodar como administrador.
AmbientCapabilities=CAP_NET_BIND_SERVICE

NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=read-only
ReadWritePaths=__PASTA__/dados/https

[Install]
WantedBy=multi-user.target
